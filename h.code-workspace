import streamlit as st
from docx import Document
import pandas as pd
import json

from reportlab.lib.pagesizes import A4
from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle
from reportlab.lib.styles import getSampleStyleSheet
from reportlab.lib import colors
from io import BytesIO

st.set_page_config(page_title="Dokumentenprüfer", layout="wide")

st.title("Lokaler Dokumentenprüfer")

# =========================
# FILE READ
# =========================

def read_docx(file):
    doc = Document(file)

    structured_text = []
    current_heading = "Unbekannt"

    for para in doc.paragraphs:
        text = para.text.strip()

        if not text:
            continue

        if para.style.name.startswith("Heading"):
            current_heading = text

        structured_text.append({
            "text": text,
            "heading": current_heading
        })

    return structured_text

# =========================
# LOADERS
# =========================

def load_checklist():
    with open("pruefkatalog.json", "r", encoding="utf-8") as f:
        return json.load(f)

def load_normlogik_82079():
    with open("normlogik_82079.json", "r", encoding="utf-8") as f:
        return json.load(f)

def load_ce_logik():
    with open("ce_logik.json", "r", encoding="utf-8") as f:
        return json.load(f)

# =========================
# BASIS CHECK
# =========================

def check_document(structured_text):
    findings = []
    checklist = load_checklist()

    full_text = " ".join([item["text"] for item in structured_text]).lower()

    for rule in checklist:
        if not any(keyword in full_text for keyword in rule["keywords"]):
            findings.append({
                "ID": rule["id"],
                "Normlogik": "Basisprüfung",
                "Bereich": rule["bereich"],
                "Pflicht": "-",
                "Fehlerklasse": rule["fehlerklasse"],
                "Bewertung": "Nicht gefunden",
                "Fundstelle": "Nicht vorhanden",
                "Empfehlung": rule["empfehlung"],
                "Gewichtung": rule["gewichtung"],
                "Zeitaufwand_min": rule["gewichtung"] * 12
            })

    # Lesbarkeit
    for item in structured_text:
        sentence = item["text"]

        if len(sentence.split()) > 25:
            findings.append({
                "ID": "TXT-001",
                "Normlogik": "Basisprüfung",
                "Bereich": "Lesbarkeit",
                "Pflicht": "-",
                "Fehlerklasse": "Mittel",
                "Bewertung": "Satz zu lang",
                "Fundstelle": item["heading"],
                "Empfehlung": sentence[:150],
                "Gewichtung": 2,
                "Zeitaufwand_min": 15
            })

    return findings

